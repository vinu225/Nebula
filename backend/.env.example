# ============================================================
# Sovereign AI Workbench — Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your environment.
# ALL services run locally. No cloud APIs are used.
# ============================================================

# --- Application ---
APP_NAME="MRPL AI Workbench"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_API_KEY=sovereign-dev-key-change-in-production

# --- Ollama (Local LLM Server) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# --- PostgreSQL (Local Database + pgvector) ---
DATABASE_URL=postgresql+asyncpg://sovereign:sovereign@localhost:5432/sovereign_workbench
DATABASE_SYNC_URL=postgresql://sovereign:sovereign@localhost:5432/sovereign_workbench
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=sovereign
POSTGRES_DB=sovereign_workbench

# --- MinIO (Local Object Storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_ARTIFACTS=artifacts
MINIO_BUCKET_SANDBOX=sandbox

# --- Docker Sandbox ---
SANDBOX_IMAGE=sovereign-sandbox:latest
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_NETWORK_DISABLED=true

# --- RAG / Embeddings ---
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# --- Security ---
SOVEREIGN_MODE=true
BLOCK_EXTERNAL_NETWORK=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
